#!/usr/bin/env bash
# Copy the tracked configs from this repo to their live locations (no symlinks).
#
#   bin/sync-config           apply changes; skip files edited locally
#   bin/sync-config --dry-run show what would change
#   bin/sync-config --force   also overwrite locally edited files (backup kept)
#
# Runs automatically after `git pull` once hooks are enabled:
#   git config core.hooksPath .githooks
#
# A live file is "edited locally" when it differs from both the repo and the
# copy this script last installed. Those are never overwritten silently.
# Works with macOS's bash 3.2.

set -eu

# repo path -> live path (directories are synced file by file)
MAP="
.zshrc                ~/.zshrc
.tmux.conf            ~/.tmux.conf
starship.toml         ~/.config/starship.toml
hyfetch.json          ~/.config/hyfetch.json
ghostty               ~/.config/ghostty
.config/wezterm       ~/.config/wezterm
agents/global.md      ~/.claude/CLAUDE.md
agents/global.md      ~/.codex/AGENTS.md
"

REPO="$(cd "$(dirname "$0")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dots-and-configs"
STATE="$STATE_DIR/applied"
DRY=false
FORCE=false

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY=true ;;
    --force) FORCE=true ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "sync-config: unknown option '$arg'" >&2; exit 2 ;;
  esac
done

if command -v sha256sum >/dev/null 2>&1; then
  hash() { sha256sum "$1" | cut -d' ' -f1; }
else
  hash() { shasum -a 256 "$1" | cut -d' ' -f1; }
fi

mkdir -p "$STATE_DIR"
touch "$STATE"

last_hash() { awk -F'\t' -v p="$1" '$1 == p { h = $2 } END { print h }' "$STATE"; }

record() {
  $DRY && return 0
  local tmp="$STATE.tmp"
  awk -F'\t' -v p="$1" '$1 != p' "$STATE" > "$tmp"
  printf '%s\t%s\n' "$1" "$2" >> "$tmp"
  mv "$tmp" "$STATE"
}

updated=0
skipped=0

sync_file() {
  local src="$1" dst="$2"
  local want live last
  want=$(hash "$src")

  if [ ! -e "$dst" ]; then
    echo "  new      $dst"
  else
    live=$(hash "$dst")
    if [ "$live" = "$want" ]; then
      record "$dst" "$want"
      return 0
    fi
    last=$(last_hash "$dst")
    if [ "$live" != "$last" ] && ! $FORCE; then
      echo "  SKIPPED  $dst (edited locally; differs from repo)"
      diff -u "$dst" "$src" | sed 's/^/           /' | head -40 || true
      skipped=$((skipped + 1))
      return 0
    fi
    echo "  updated  $dst"
  fi

  if ! $DRY; then
    if [ -e "$dst" ] && $FORCE && [ "$(hash "$dst")" != "$(last_hash "$dst")" ]; then
      cp -p "$dst" "$dst.bak-$(date +%Y%m%d-%H%M%S)"
    fi
    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"
    record "$dst" "$want"
  fi
  updated=$((updated + 1))
}

echo "Syncing $REPO"
while read -r rel live; do
  [ -n "$rel" ] || continue
  live="${live/#\~/$HOME}"
  src="$REPO/$rel"
  if [ -d "$src" ]; then
    while read -r f; do
      sync_file "$src/$f" "$live/$f"
    done < <(cd "$src" && find . -type f ! -name '.DS_Store' | sed 's|^\./||' | sort)
  elif [ -f "$src" ]; then
    sync_file "$src" "$live"
  fi
done <<< "$MAP"

$DRY && prefix="Would update" || prefix="Updated"
echo "$prefix $updated file(s); $skipped skipped."
if [ "$skipped" -gt 0 ]; then
  echo "Skipped files were edited locally. Keep the edit by copying it into the repo,"
  echo "or rerun with --force to replace it with the repo version (a .bak copy is kept)."
fi
