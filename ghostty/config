theme = Rose Pine
font-family = JetBrainsMono Nerd Font
font-size = 12
mouse-hide-while-typing = true
background-opacity = 1
background-blur-radius = 20
#macos-titlebar-style = "hidden"
window-padding-x = 12
window-padding-y = 14

# Match WezTerm: no title bar, tabs only when there are several,
# no scrollbar, silent bell.
gtk-titlebar = false
window-show-tab-bar = auto
scrollbar = never
bell-features = no-system,no-audio,no-attention,no-title,no-border

cursor-style = block
cursor-style-blink = false
# Uzume warm orange #f6ad75 dimmed to ~82%; dark Rose Pine base for the letter.
cursor-color = #ca8e60
cursor-text = #191724
shell-integration-features = no-cursor

# Shaders run in order (needs Ghostty 1.2+); paths are relative to this file.
# Comment out a line to turn that effect off.
custom-shader = shaders/vignette.glsl
custom-shader = shaders/cursor_trail.glsl
#custom-shader = shaders/cursor_ripple.glsl
custom-shader = shaders/cursor_land_pulse.glsl
custom-shader = shaders/cursor_glow.glsl
custom-shader-animation = true
